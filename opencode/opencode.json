{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": {
          "*": "ask",
          "/tmp/opencode/**": "allow"
        },
        "external_directory": {
          "*": "ask",
          "/tmp/opencode/**": "allow"
        },
        "bash": {
          "*": "ask",
          "bun -e *": "allow",
          "bun test *": "allow",
          "bunx eslint *": "allow",
          "bunx tsc *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git ls-files *": "allow",
          "git show *": "allow",
          "git status *": "allow"
        }
    }
}